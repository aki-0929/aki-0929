<Window x:Class="Kaling.StressTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CommandChannel 压测"
        Width="960" Height="640"
        MinWidth="800" MinHeight="520"
        Background="#0D1117"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="CommandChannel" FontSize="28" FontWeight="Bold" Foreground="#58A6FF" />
            <TextBlock Text="  内存 Loopback 高频压测" FontSize="28" Foreground="#C9D1D9" VerticalAlignment="Bottom" />
        </StackPanel>

        <Border Grid.Row="1" Background="#161B22" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#3FB950" Margin="0,0,10,0" />
                    <TextBlock x:Name="StatusText" Text="运行中" FontSize="18" Foreground="#3FB950" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="ElapsedText" Text="00:00:00.0"
                           FontSize="36" FontWeight="SemiBold" Foreground="#F0F6FC" FontFamily="Consolas" />
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Rows="2" Columns="2" Margin="0,0,0,16">
            <Border Margin="8" Background="#161B22" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="接收速率 (瞬时)" Foreground="#8B949E" FontSize="14" />
                    <TextBlock x:Name="InstRecvText" Text="0" Foreground="#3FB950" FontSize="48" FontWeight="Bold" FontFamily="Consolas" />
                    <TextBlock x:Name="InstRecvSubText" Text="msg/s" Foreground="#8B949E" FontSize="13" />
                </StackPanel>
            </Border>
            <Border Margin="8" Background="#161B22" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="发送速率 (瞬时)" Foreground="#8B949E" FontSize="14" />
                    <TextBlock x:Name="InstSendText" Text="0" Foreground="#58A6FF" FontSize="48" FontWeight="Bold" FontFamily="Consolas" />
                    <TextBlock x:Name="InstSendSubText" Text="msg/s" Foreground="#8B949E" FontSize="13" />
                </StackPanel>
            </Border>
            <Border Margin="8" Background="#161B22" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="接收吞吐" Foreground="#8B949E" FontSize="14" />
                    <TextBlock x:Name="MibText" Text="0.00" Foreground="#D2A8FF" FontSize="48" FontWeight="Bold" FontFamily="Consolas" />
                    <TextBlock Text="MiB/s (平均)" Foreground="#8B949E" FontSize="13" />
                </StackPanel>
            </Border>
            <Border Margin="8" Background="#161B22" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="在途消息" Foreground="#8B949E" FontSize="14" />
                    <TextBlock x:Name="InFlightText" Text="0" Foreground="#FFA657" FontSize="48" FontWeight="Bold" FontFamily="Consolas" />
                    <TextBlock Text="已发送 − 已接收" Foreground="#8B949E" FontSize="13" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3" Background="#161B22" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="4">
                    <TextBlock Text="总发送" Foreground="#8B949E" FontSize="12" />
                    <TextBlock x:Name="SentText" Text="0" Foreground="#C9D1D9" FontSize="22" FontFamily="Consolas" />
                    <TextBlock x:Name="AvgSendText" Text="平均 0 /s" Foreground="#6E7681" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4">
                    <TextBlock Text="总接收" Foreground="#8B949E" FontSize="12" />
                    <TextBlock x:Name="RecvText" Text="0" Foreground="#C9D1D9" FontSize="22" FontFamily="Consolas" />
                    <TextBlock x:Name="AvgRecvText" Text="平均 0 /s" Foreground="#6E7681" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="4">
                    <TextBlock Text="错误" Foreground="#8B949E" FontSize="12" />
                    <TextBlock x:Name="ErrorsText" Text="send 0 / read 0" Foreground="#F85149" FontSize="22" FontFamily="Consolas" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="4">
                    <TextBlock Text="配置" Foreground="#8B949E" FontSize="12" />
                    <TextBlock x:Name="ConfigText" Text="—" Foreground="#C9D1D9" FontSize="14" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Button Grid.Row="4" x:Name="StopButton" Content="停止压测" Height="44" FontSize="16"
                Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D"
                Click="StopButton_OnClick" />
    </Grid>
</Window>
